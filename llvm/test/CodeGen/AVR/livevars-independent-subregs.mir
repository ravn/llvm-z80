# RUN: llc -mtriple=avr -run-pass=livevars,dead-mi-elimination %s -o - | FileCheck %s
#
# llvm/llvm-project#156428: r25r24 = r25:r24 are independent halves; writing
# one does not clobber the other. When the two halves are defined by separate
# instructions, LiveVariables stamped only the later (LDIRdK) with implicit-def
# $r25r24, leaving the earlier $r25 = MOVRdRr looking dead, so DeadMI removed it
# and the later read of $r25 became a miscompile. The fix adds an implicit use
# of the sibling half so it stays live.
--- |
  define void @f() { ret void }
  declare void @use()
...
---
name:            f
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r22
    $r25 = MOVRdRr $r22
    $r24 = LDIRdK 42
    $r20 = MOVRdRr $r25
    RCALLk @use, implicit $r25r24, implicit $r20
...

# CHECK-LABEL: name: f
# CHECK:      $r25 = MOVRdRr killed $r22
# CHECK-NEXT: $r24 = LDIRdK 42, implicit $r25, implicit-def $r25r24
# CHECK-NEXT: $r20 = MOVRdRr $r25
