# RUN: llc -mtriple=avr -run-pass=livevars %s -o - | FileCheck %s
#
# llvm/llvm-project#156428: when two independent halves of a pair (AVR
# r25r24 = r25:r24) are defined by SEPARATE instructions, LiveVariables stamps
# the later def with implicit-def $r25r24 but left the earlier half's def
# unprotected, so it looked dead and MachineCopyPropagation deleted it. The fix
# adds an implicit use of the earlier-defined sibling to keep it live.
--- |
  define void @two_defs() { ret void }
...
---
name:            two_defs
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r22
    $r24 = MOVRdRr $r22
    $r25 = LDIRdK 0
    RET implicit $r25r24
...

# CHECK-LABEL: name: two_defs
# CHECK:      $r24 = MOVRdRr killed $r22
# CHECK-NEXT: $r25 = LDIRdK 0, implicit $r24, implicit-def $r25r24
