# RUN: llc -mtriple=z80 -run-pass=z80-late-opt %s -o - | FileCheck %s
# RUN: llc -mtriple=z80 -run-pass=z80-late-opt -debugify-and-strip-all-safe \
# RUN:     %s -o - | FileCheck %s
#
# ravn/llvm-z80#206: extend peephole #18 to track all GR8 registers.
# When any register already holds a constant n, a later `LD r,n` becomes
# the cheaper `LD r,r'` (1 B vs 2 B, saves 1 B/fire).

--- |
  target triple = "z80"
  define void @single_reuse() { ret void }
  define void @chain_reuse() { ret void }
  define void @a_seeds_b() { ret void }
...

# Single non-A reuse: LD B,7 seeds tracker; LD C,7 -> LD C,B.
---
name:            single_reuse
tracksRegLiveness: true
body: |
  bb.0:
    LD_B_n 7, implicit-def $b
    LD_C_n 7, implicit-def $c
    RET implicit $b, implicit $c
...

# CHECK-LABEL: name: single_reuse
# CHECK:      LD_B_n 7
# CHECK-NEXT: LD_C_B
# CHECK-NOT:  LD_C_n

# Chain: first non-A register seeds; subsequent loads fold to copies from it.
---
name:            chain_reuse
tracksRegLiveness: true
body: |
  bb.0:
    LD_D_n 0, implicit-def $d
    LD_E_n 0, implicit-def $e
    LD_H_n 0, implicit-def $h
    RET implicit $d, implicit $e, implicit $h
...

# CHECK-LABEL: name: chain_reuse
# CHECK:      LD_D_n 0
# CHECK-NEXT: LD_E_D
# CHECK-NEXT: LD_H_D

# A seeds from XOR_A; B load folds to LD B,A (original #18 behavior preserved).
---
name:            a_seeds_b
tracksRegLiveness: true
body: |
  bb.0:
    XOR_A implicit-def $a, implicit-def $flags, implicit undef $a
    LD_B_n 0, implicit-def $b
    RET implicit $a, implicit $b
...

# CHECK-LABEL: name: a_seeds_b
# CHECK:      XOR_A
# CHECK-NEXT: LD_B_A
