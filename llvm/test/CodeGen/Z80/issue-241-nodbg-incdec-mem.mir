# RUN: llc -mtriple=z80 -run-pass=z80-late-opt -verify-machineinstrs %s -o - \
# RUN:     | FileCheck %s
# RUN: llc -mtriple=z80 -run-pass=z80-late-opt -verify-machineinstrs \
# RUN:     -debugify-and-strip-all-safe %s -o - | FileCheck %s
#
# ravn/llvm-z80#241 (follow-up to #221): in-memory INC/DEC peephole
# (LD A,(addr); INC/DEC A; LD (addr),A → LD HL,addr; INC/DEC (HL)) used raw
# std::next for I0→I1→I2→I3 and in the inner checkADeadAfterBranch lambda.
# Under -g a DBG_VALUE between matched instructions would cause a silent bail.
# Fixed with MBB.SkipPHIsLabelsAndDebug(std::next()) throughout.

--- |
  target triple = "z80"
  @g = external global i8
  define void @inc_mem_ret() { ret void }
  define void @dec_mem_ret() { ret void }
...

# INC shape: LD A,(g); INC A; LD (g),A; RET → LD HL,g; INC (HL); RET.
# A is dead after the store (function returns next — isReturn() path).
---
name:            inc_mem_ret
tracksRegLiveness: true
body: |
  bb.0:
    LD_A_nnind @g, implicit-def $a
    INC_A implicit-def $a, implicit-def $flags, implicit $a
    LD_nnind_A @g, implicit $a
    RET
...

# CHECK-LABEL: name: inc_mem_ret
# CHECK:      LD_HL_nn @g
# CHECK-NEXT: INC_HLind
# CHECK-NEXT: RET
# CHECK-NOT:  LD_A_nnind
# CHECK-NOT:  INC_A
# CHECK-NOT:  LD_nnind_A

# DEC shape: LD A,(g); DEC A; LD (g),A; RET → LD HL,g; DEC (HL); RET.
---
name:            dec_mem_ret
tracksRegLiveness: true
body: |
  bb.0:
    LD_A_nnind @g, implicit-def $a
    DEC_A implicit-def $a, implicit-def $flags, implicit $a
    LD_nnind_A @g, implicit $a
    RET
...

# CHECK-LABEL: name: dec_mem_ret
# CHECK:      LD_HL_nn @g
# CHECK-NEXT: DEC_HLind
# CHECK-NEXT: RET
# CHECK-NOT:  LD_A_nnind
# CHECK-NOT:  DEC_A
# CHECK-NOT:  LD_nnind_A
