; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=z80 -z80-asm-format=sdasz80 -O0 < %s | FileCheck %s
;
; SDCC has two distinct calling conventions with OPPOSITE argument order:
;   __sdcccall(0) (cc 241): all args on stack, right-to-left push.
;   __smallc      (cc 242): all args on stack, left-to-right push (first arg deepest).
; They are identical for a single argument.  z88dk's Small-C library is
; compiled __smallc.  Constants: 0x1111=4369, 0x2222=8738, 0x3333=13107.

declare cc 241 i16 @f0(i16, i16, i16)
declare cc 242 i16 @fs(i16, i16, i16)

; sdcccall(0): push 3rd, 2nd, 1st (first arg ends nearest the return address).
define void @call_sdcccall0() {
; CHECK-LABEL: call_sdcccall0:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ld hl,#13107
; CHECK-NEXT:    push hl
; CHECK-NEXT:    ld hl,#8738
; CHECK-NEXT:    push hl
; CHECK-NEXT:    ld hl,#4369
; CHECK-NEXT:    push hl
; CHECK-NEXT:    call _f0
; CHECK-NEXT:    pop af
; CHECK-NEXT:    pop af
; CHECK-NEXT:    pop af
; CHECK-NEXT:    ret
  call cc 241 i16 @f0(i16 4369, i16 8738, i16 13107)
  ret void
}

; __smallc: push 1st, 2nd, 3rd (first arg ends deepest, last at top).
define void @call_smallc() {
; CHECK-LABEL: call_smallc:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ld hl,#4369
; CHECK-NEXT:    push hl
; CHECK-NEXT:    ld hl,#8738
; CHECK-NEXT:    push hl
; CHECK-NEXT:    ld hl,#13107
; CHECK-NEXT:    push hl
; CHECK-NEXT:    call _fs
; CHECK-NEXT:    pop af
; CHECK-NEXT:    pop af
; CHECK-NEXT:    pop af
; CHECK-NEXT:    ret
  call cc 242 i16 @fs(i16 4369, i16 8738, i16 13107)
  ret void
}
