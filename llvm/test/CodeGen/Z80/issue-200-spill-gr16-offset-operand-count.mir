# RUN: llc -mtriple=z80 -mattr=+static-stack -run-pass=prologepilog \
# RUN:     -z80-static-stack-fp-direct-addr=false \
# RUN:     -verify-machineinstrs %s -o - | FileCheck %s
#
# NOTE: the #263 direct-addressing lever (default ON) turns constant-base frame
# slots into direct absolute stores, bypassing the SPILL_GR16 frame-slot path
# this test guards.  Pin the lever OFF to keep exercising the operand-count fix.
#
# ravn/llvm-z80 #200: under +static-stack, an address-taken local array forces
# an IX frame.  SPILL_GR16 / RELOAD_GR16 are declared with three operands
# (src/dst, $fi, $offset), but eliminateFrameIndex folds the $offset
# displacement into the resolved frame offset and removes it, leaving a
# 2-operand instruction that -verify-machineinstrs rejected with
# "Too few operands" after PEI.  The fix restores the consumed $offset operand
# as a 0 placeholder (its value is already folded into operand 1, and
# expandPostRAPseudo reads only operand 1) so the post-PEI operand count
# matches the MCInstrDesc.  This is purely cosmetic: codegen is unchanged.
#
# The test passes iff -verify-machineinstrs is clean (no "Too few operands")
# AND each surviving SPILL_GR16/RELOAD_GR16 carries the resolved offset plus
# the restored 0 placeholder.

--- |
  target datalayout = "e-m:o-p:16:8-i16:8-i32:8-i64:8-i128:8-f32:8-f64:8-n8:16"
  target triple = "z80"

  define dso_local zeroext i16 @f(i16 %0, i16 %1) {
    %3 = alloca [5 x i16], align 1
    call void @sink(ptr nonnull %3)
    %4 = load i16, ptr %3, align 1
    ret i16 %4
  }

  declare dso_local void @sink(ptr)
...
---
name:            f
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noVRegs:         true
frameInfo:
  adjustsStack:    true
  hasCalls:        true
  maxCallFrameSize: 4294967295
stack:
  - { id: 0, name: '', type: default, offset: 0, size: 10, alignment: 1 }
  - { id: 1, name: '', type: spill-slot, offset: 0, size: 2, alignment: 1 }
body:             |
  bb.0 (%ir-block.2):
    liveins: $de, $hl

    renamable $bc = COPY $hl
    renamable $hl = LEA_IX_FI %stack.0
    ; CHECK: SPILL_GR16 killed renamable $hl, {{-?[0-9]+}}, 0
    SPILL_GR16 killed renamable $hl, %stack.1, 0 :: (store (s16) into %stack.1, align 1)
    ; CHECK: SPILL_GR16 renamable $bc, {{-?[0-9]+}}, 0
    SPILL_GR16 renamable $bc, %stack.0, 0
    ; CHECK: SPILL_GR16 killed renamable $de, {{-?[0-9]+}}, 0
    SPILL_GR16 killed renamable $de, %stack.0, 2
    ADJCALLSTACKDOWN 0, 0, implicit-def $sp, implicit $sp
    ; CHECK: RELOAD_GR16 {{-?[0-9]+}}, 0
    $hl = RELOAD_GR16 %stack.1, 0 :: (load (s16) from %stack.1, align 1)
    CALL_nn @sink, z80_csr, implicit-def dead $a, implicit-def dead $bc, implicit-def dead $de, implicit-def dead $hl, implicit-def $iy, implicit-def $flags, implicit $hl
    ADJCALLSTACKUP 0, 0, implicit-def $sp, implicit-def dead $hl, implicit-def dead $a, implicit $sp
    renamable $de = RELOAD_GR16 %stack.0, 0
    RET implicit $de
...
