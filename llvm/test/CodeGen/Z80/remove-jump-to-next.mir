# RUN: llc -mtriple=z80 -run-pass=z80-remove-jump-to-next %s -o - | FileCheck %s
#
# ravn/llvm-z80#250: general late peephole removing an unconditional branch to
# the block's own layout-next successor (a jump to the immediately-following
# address == a fall-through).  Runs last in addPreEmitPass to catch redundant
# jumps left by hbf / pseudo expansion, which BranchFolding ran too early to see.

--- |
  target triple = "z80"
  define void @uncond_to_next() { ret void }
  define void @cond_then_fallthrough() { ret void }
  define void @uncond_to_far() { ret void }
...

# An unconditional JP to the next block is a pure fall-through -> removed.
---
name:            uncond_to_next
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    JP_nn %bb.1
  bb.1:
    RET
...
# CHECK-LABEL: name: uncond_to_next
# CHECK-NOT: JP_nn
# CHECK: bb.1:

# Conditional to a far block, then an unconditional to the fall-through block:
# keep the conditional, drop the redundant unconditional.
---
name:            cond_then_fallthrough
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $flags
    JP_C_nn %bb.2, implicit $flags
    JP_nn %bb.1
  bb.1:
    RET
  bb.2:
    RET
...
# The conditional survives (re-inserted, here as the short JR_C_e form); the
# redundant unconditional to the fall-through is gone.
# CHECK-LABEL: name: cond_then_fallthrough
# CHECK: J{{[PR]}}_C{{[_a-z]*}} %bb.2
# CHECK-NOT: JP_nn %bb.1
# CHECK: bb.1:

# An unconditional JP whose target is NOT the layout-next block is a real jump
# and must be kept.
---
name:            uncond_to_far
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.2
    JP_nn %bb.2
  bb.1:
    RET
  bb.2:
    RET
...
# CHECK-LABEL: name: uncond_to_far
# CHECK: JP_nn %bb.2
