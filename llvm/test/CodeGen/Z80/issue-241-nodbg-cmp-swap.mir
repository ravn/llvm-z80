# RUN: llc -mtriple=z80 -run-pass=z80-late-opt -verify-machineinstrs %s -o - \
# RUN:     | FileCheck %s
# RUN: llc -mtriple=z80 -run-pass=z80-late-opt -verify-machineinstrs \
# RUN:     -debugify-and-strip-all-safe %s -o - | FileCheck %s
#
# ravn/llvm-z80#241 (follow-up to #221): comparison operand-swap peephole
# (LD r,A; LD A,n; CP r; JR C/NC → CP n+1; JR NC/C) used raw std::next for
# the four-step I0→I1→I2→I3 adjacency walk and for the FLAGS liveness check.
# Under -g a DBG_VALUE between matched instructions would cause a silent bail.
# Fixed with MBB.SkipPHIsLabelsAndDebug(std::next()) throughout.
#
# Pattern: "imm < A_orig" (JR C when carry set, i.e., imm < A) is rewritten
# as "A_orig >= imm+1" (JR NC when carry clear).  Requires imm < 255 and
# FLAGS dead after the branch.

--- |
  target triple = "z80"
  define void @cmp_swap_jr_c() { ret void }
...

# LD B,A; LD A,5; CP B; JR C → CP 6; JR NC.
---
name:            cmp_swap_jr_c
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $a
    LD_B_A implicit-def $b, implicit $a
    LD_A_n 5, implicit-def $a
    CP_B implicit-def $flags, implicit $a, implicit $b
    JR_C_e %bb.1, implicit $flags
    JR_e %bb.2
  bb.1:
    RET
  bb.2:
    RET
...

# CHECK-LABEL: name: cmp_swap_jr_c
# CHECK:      CP_n 6
# CHECK-NEXT: JR_NC_e
# CHECK-NOT:  LD_B_A
# CHECK-NOT:  LD_A_n
# CHECK-NOT:  CP_B
# CHECK-NOT:  JR_C_e
