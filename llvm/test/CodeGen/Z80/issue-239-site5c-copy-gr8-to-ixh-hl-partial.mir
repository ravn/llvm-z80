# RUN: llc -mtriple=z80 \
# RUN:     -run-pass=postrapseudos -verify-machineinstrs %s -o - \
# RUN:     | FileCheck %s
#
# ravn/llvm-z80#239 site 5c: copyPhysReg GR8 -> IXH/IXL/IYH/IYL (src not
# H/L), without +undocumented.  The path saves HL unconditionally before
# PUSH IX; POP HL; LD H/L, src; PUSH HL; POP IX.  When HL is partially
# undef the save PUSH_HL reads the undef half and trips -verify-machineinstrs.
#
# Fixture: COPY $ixh = $e.  $h live, $l undef.
#
# Fix: gate the save PUSH_HL on liveness; IMPLICIT_DEF dead half first.

--- |
  target triple = "z80"
  define void @copy_e_to_ixh_h_live_l_undef() { ret void }
...
---
name:            copy_e_to_ixh_h_live_l_undef
alignment:       1
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $a, $e, $h, $ix
    ; COPY $ixh = $e without +undocumented.  $h live, $l undef.
    ; Pre-fix: unconditional PUSH_HL read partial-undef $hl.
    $ixh = COPY $e
    AND_r killed $h, implicit-def $a, implicit-def $flags, implicit $a
    RET implicit $a
...

# CHECK-LABEL: name: copy_e_to_ixh_h_live_l_undef
# CHECK:      $l = IMPLICIT_DEF
# CHECK-NEXT: PUSH_HL
# CHECK:      PUSH_IX
# CHECK:      POP_HL
# CHECK:      LD_H_E
# CHECK:      PUSH_HL
# CHECK:      POP_IX
# CHECK:      POP_HL
