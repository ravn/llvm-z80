# RUN: llc -mtriple=z80 -run-pass=livevars %s -o - | FileCheck %s
#
# ravn/llvm-z80 #156428: LiveVariables::HandlePhysRegUse added a spurious
# super-register implicit-def (e.g. implicit-def $hl) to an instruction that
# only defined a sub-register such as $l, assuming -- as on x86's AL/AX/EAX --
# that the other half was already defined.  On Z80 the halves of a register
# pair are INDEPENDENT (writing L does not touch H), so claiming $hl is defined
# from a lone $l def corrupts liveness and lets MachineCopyPropagation delete a
# still-live $h copy as dead.  The fix only adds the super-register implicit-def
# when EVERY leaf sub-register is actually defined.

--- |
  target triple = "z80"
  define void @only_l() { ret void }
  define void @both_halves() { ret void }
...
---
# Only $l is defined before $hl is used.  $h is NOT defined, so the lone $l def
# must NOT be turned into an implicit def of the whole pair.
name:            only_l
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $c
    LD_L_C implicit-def $l, implicit $c
    RET implicit $hl
...
---
# Both halves are defined separately before $hl is used, so the pair really is
# fully defined: the later half-def legitimately gains implicit-def $hl
# (original behavior preserved).
name:            both_halves
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $c, $b
    LD_L_C implicit-def $l, implicit $c
    LD_H_B implicit-def $h, implicit $b
    RET implicit $hl
...

# CHECK-LABEL: name: only_l
# CHECK:     LD_L_C implicit-def $l, implicit killed $c
# CHECK-NOT: implicit-def $hl
# CHECK:     RET implicit killed $hl

# CHECK-LABEL: name: both_halves
# CHECK:     LD_L_C implicit-def $l, implicit killed $c
# CHECK:     LD_H_B implicit-def $h, implicit killed $b, implicit $l, implicit-def $hl
# CHECK:     RET implicit killed $hl
