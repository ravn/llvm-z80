# RUN: llc -mtriple=z80 -run-pass=z80-late-opt -verify-machineinstrs %s -o - \
# RUN:     | FileCheck %s
# RUN: llc -mtriple=z80 -run-pass=z80-late-opt -verify-machineinstrs \
# RUN:     -debugify-and-strip-all-safe %s -o - | FileCheck %s
#
# ravn/llvm-z80#241 (follow-up to #221): ADD commutativity peephole
# (LD C,L; LD B,H; EX DE,HL; ADD HL,BC → ADD HL,DE) used raw std::next for
# all five adjacency steps and would silently bail under -g when a DBG_VALUE
# pseudo appeared between the matched instructions.  Fixed with
# MBB.SkipPHIsLabelsAndDebug(std::next()) throughout.
#
# Fixture: plain HL-result shape (ADD HL,DE result stays in HL).

--- |
  target triple = "z80"
  define void @add_comm_hl_result() { ret void }
  define void @add_comm_de_result() { ret void }
...

# HL-result: LD C,L; LD B,H; EX DE,HL; ADD HL,BC → ADD HL,DE (4 B → 1 B).
---
name:            add_comm_hl_result
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $hl, $de
    LD_C_L implicit-def $c, implicit $l
    LD_B_H implicit-def $b, implicit $h
    EX_DE_HL implicit-def $de, implicit-def $hl, implicit $de, implicit $hl
    ADD_HL_BC implicit-def $hl, implicit-def $flags, implicit $hl, implicit $bc
    RET implicit $hl
...

# CHECK-LABEL: name: add_comm_hl_result
# CHECK:      ADD_HL_DE
# CHECK-NOT:  LD_C_L
# CHECK-NOT:  LD_B_H
# CHECK-NOT:  EX_DE_HL
# CHECK-NOT:  ADD_HL_BC

# DE-result: LD C,L; LD B,H; EX DE,HL; ADD HL,BC; EX DE,HL
#          → ADD HL,DE; EX DE,HL (5 B → 2 B).
---
name:            add_comm_de_result
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $hl, $de
    LD_C_L implicit-def $c, implicit $l
    LD_B_H implicit-def $b, implicit $h
    EX_DE_HL implicit-def $de, implicit-def $hl, implicit $de, implicit $hl
    ADD_HL_BC implicit-def $hl, implicit-def $flags, implicit $hl, implicit $bc
    EX_DE_HL implicit-def $de, implicit-def $hl, implicit $de, implicit $hl
    RET implicit $de
...

# CHECK-LABEL: name: add_comm_de_result
# CHECK:      ADD_HL_DE
# CHECK-NEXT: EX_DE_HL
# CHECK-NOT:  LD_C_L
# CHECK-NOT:  LD_B_H
# CHECK-NOT:  ADD_HL_BC
