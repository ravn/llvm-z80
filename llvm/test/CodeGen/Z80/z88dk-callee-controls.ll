; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=z80 -z80-asm-format=sdasz80 -O1 < %s | FileCheck %s
;
; Controls for __z88dk_callee (cc 245): the neighbouring conventions it must not
; disturb.

; ----------------------------------------------------------------------------
; __sdcccall(0) (cc 241): the caller pushes the args and the CALLER pops them
; after the call (`pop af` x2 for two i16 args).  That cleanup side is exactly
; what distinguishes it from __z88dk_callee, whose caller does not clean up.
; ----------------------------------------------------------------------------
declare cc 241 void @sc2(i16, i16)
define void @sc_caller() {
; CHECK-LABEL: sc_caller:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ld hl,#2
; CHECK-NEXT:    push hl
; CHECK-NEXT:    ld hl,#1
; CHECK-NEXT:    push hl
; CHECK-NEXT:    call _sc2
; CHECK-NEXT:    pop af
; CHECK-NEXT:    pop af
; CHECK-NEXT:    ret
  call cc 241 void @sc2(i16 1, i16 2)
  ret void
}

; ----------------------------------------------------------------------------
; Plain default C convention is unaffected: register args, no stack cleanup.
; ----------------------------------------------------------------------------
declare void @plain2(i16, i16)
define void @plain_caller() {
; CHECK-LABEL: plain_caller:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ld hl,#1
; CHECK-NEXT:    ld de,#2
; CHECK-NEXT:    call _plain2
; CHECK-NEXT:    ret
  call void @plain2(i16 1, i16 2)
  ret void
}
